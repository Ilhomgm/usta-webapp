# Server-only. Generate unique values; never use NEXT_PUBLIC_ for secrets.
# Local marketplace defaults to data/usta.sqlite. No secrets needed for customer accounts.
USTA_DB_PATH=data/usta.sqlite
# Set this only when deploying behind a proxy, e.g. https://usta.example
USTA_PUBLIC_ORIGIN=
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional standalone Telegram launcher (do not run alongside Python bot for same token)
BOT_TOKEN=
WEB_APP_URL=
# AI: server only. Never use NEXT_PUBLIC_ for this key.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
USTA_AI_DAILY_LIMIT=25
USTA_AI_GLOBAL_DAILY_LIMIT=250
